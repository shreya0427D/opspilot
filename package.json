{
  "name": "opspilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "firebase emulators:start --only auth,firestore,storage --project demo-opspilot",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-opspilot \"vitest run -c vitest.emulator.config.mts\"",
    "test:live": "vitest run -c vitest.live.config.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.3.0",
    "@google/genai": "^2.31.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "file-type": "^22.2.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
