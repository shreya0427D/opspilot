# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web config (public by design; access is enforced by security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true => client and server talk to the local Firebase Emulators (project demo-opspilot)
NEXT_PUBLIC_USE_EMULATORS=true

# --- Server only ---
GEMINI_API_KEY=
RESEND_API_KEY=
# Must be on a domain verified in Resend (not gmail.com)
EMAIL_FROM=
# 32+ random chars; authorizes internal cron/step endpoints locally
CRON_SECRET=

# Production only (Cloud Tasks). Leave empty locally for in-process dispatch.
TASKS_QUEUE=
TASKS_INVOKER_SA=
