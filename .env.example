# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web config (public by design; access is enforced by security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true => client and server talk to the local Firebase Emulators (project demo-opspilot)
NEXT_PUBLIC_USE_EMULATORS=true

# --- Server only ---
GEMINI_API_KEY=
RESEND_API_KEY=
# Must be on a domain verified in Resend (not gmail.com)
EMAIL_FROM=
# Testing without a domain: EMAIL_FROM=onboarding@resend.dev and EMAIL_TEST_RECIPIENT=<your Resend account email>.
# All approved emails then go to that address only, marked as tests.
EMAIL_TEST_RECIPIENT=
# 32+ random chars; authorizes internal cron/step endpoints locally
CRON_SECRET=

# Hosts outside Google Cloud (Vercel) only: a Firebase service account.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the private key on one line with \n for line breaks. Never commit these.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Production only (Cloud Tasks). Leave empty locally for in-process dispatch.
TASKS_QUEUE=
TASKS_INVOKER_SA=
# Optional: override the standard model ID (default gemini-3.6-flash)
GEMINI_MODEL_STANDARD=
# Optional: which Google Cloud project each Gemini key belongs to, e.g. 1=proj-a,2=proj-a,3=proj-b.
# Quota exhaustion only falls back to keys in a *different* declared project.
GEMINI_KEY_PROJECTS=

# Invoice file storage (EdgeStore, private bucket). Server-only: never prefix with NEXT_PUBLIC_.
# Create a project at https://dashboard.edgestore.dev and copy its keys.
EDGESTORE_ACCESS_KEY=
EDGESTORE_SECRET_KEY=
